# Postgres connection string.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Public base URL used to build email verification / password reset links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend transactional email (optional). Without these, emails are logged to the
# console instead of sent — used by the legacy email-based signup/reset flows.
RESEND_API_KEY=""
RESEND_FROM="onboarding@resend.dev"

# BuyMeACoffee webhook shared secret (optional).
BMAC_SECRET=""

# Cloudflare Turnstile (bot protection on signup). Free tier: https://developers.cloudflare.com/turnstile/
# Without these set, signup allows requests through in development but blocks them in production.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Secret used to sign the server-issued form-render timestamp checked on signup
# (rejects submissions faster than a human could plausibly fill the form). Any
# long random string; set a real one in production.
FORM_TOKEN_SECRET=""
