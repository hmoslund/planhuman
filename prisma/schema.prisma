generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(cuid())
  name                    String?
  email                   String?                  @unique
  alias                   String?                  @unique
  passwordHash            String
  recoveryCodeHash        String?
  country                 String                   @default("DK")
  currency                String                   @default("kr")
  language                String?
  emailVerified           Boolean                  @default(false)
  isAdmin                 Boolean                  @default(false)
  donated                 Boolean                  @default(false)
  donatedAt               DateTime?
  userNumber              Int?
  type                    String?
  becameUserDate          DateTime?                @map("became_user_date") @db.Date
  aiPromptCount           Int                      @default(0) @map("ai_prompt_count")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  wealthRecords           WealthRecord[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WealthRecord {
  id        String   @id @default(cuid())
  userId    String
  blocks    Json
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SignupAttempt {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

// One sponsor slot per currency, shown to non-donor users on the dashboard.
model Sponsor {
  id        String   @id @default(cuid())
  currency  String   @unique
  link      String
  logoData  String?
  text      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per supported country code, curated by admins in the backoffice and used to
// enrich the AI-prompt's country-context section. Starts empty — rows are created lazily
// on first admin save, not seeded by migration.
model CountryFacts {
  country              String    @id
  inflationRate        Float?    @map("inflation_rate")
  pensionYieldPct       Float?    @map("pension_yield_pct")
  pensionAge            Int?      @map("pension_age")
  pensionTypeNames      String?   @map("pension_type_names")
  factoids              String?
  housingMarketOutlook  String?   @map("housing_market_outlook")
  asOf                  DateTime? @map("as_of") @db.Date
  updatedBy             String?   @map("updated_by")
  updatedAt             DateTime  @updatedAt @map("updated_at")
}
